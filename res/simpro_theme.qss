/*
 * SimPro style theme for the OpenFFBoard Configurator.
 * Visual only: this file changes colors, spacing and shapes of the widgets.
 * No widget, signal or behaviour is touched by it.
 *
 * Palette
 *   page background   #262A33
 *   card background   #1D1F25
 *   sidebar / input   #17181C
 *   border            #33363F
 *   muted text        #9A9DA6
 *   text              #F2F2F2
 *   accent red        #C8161D   (hover #E0242B, pressed #A11016)
 */

/* ---------- Base ---------- */
QWidget {
    color: #F2F2F2;
    font-size: 10pt;
    selection-background-color: #C8161D;
    selection-color: #FFFFFF;
}

QMainWindow, QDialog {
    background-color: #262A33;
}

QWidget:disabled {
    color: #5E616A;
}

QLabel {
    background: transparent;
}

QToolTip {
    background-color: #17181C;
    color: #F2F2F2;
    border: 1px solid #C8161D;
    border-radius: 4px;
    padding: 6px 8px;
}

/* ---------- Menu bar (top) ---------- */
QMenuBar {
    background-color: #1B1D22;
    border-bottom: 1px solid #2C2F37;
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    color: #C9CBD1;
    padding: 6px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #2B2E36;
    color: #FFFFFF;
}
QMenuBar::item:pressed {
    background-color: #C8161D;
    color: #FFFFFF;
}

QMenu {
    background-color: #1D1F25;
    border: 1px solid #33363F;
    border-radius: 6px;
    padding: 6px 0px;
}
QMenu::item {
    color: #F2F2F2;
    padding: 7px 28px 7px 22px;
    background: transparent;
}
QMenu::item:selected {
    background-color: #C8161D;
    color: #FFFFFF;
}
QMenu::item:disabled {
    color: #5E616A;
}
QMenu::separator {
    height: 1px;
    background: #33363F;
    margin: 5px 10px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 4px;
}

/* ---------- Main navigation (left icon side bar like SimPro) ---------- */
QWidget#simproSideBar {
    background-color: #141519;
    border-right: 1px solid #24262D;
}
QListWidget#simproNav {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    outline: 0;
}
QListWidget#simproNav::item {
    border: none;
    background: transparent;
}
QLabel#simproPageTitle {
    color: #FFFFFF;
    font-size: 24pt;
    font-weight: bold;
    padding: 10px 18px 6px 18px;
}
QTabWidget#tabWidget_main::pane {
    background-color: transparent;
    border: none;
}

/* Info strip under the title (connection, RAM, board...) */
QWidget#simproHeader {
    background-color: #1D1F25;
    border: 1px solid #2C2F37;
    border-radius: 8px;
}
QWidget#simproHeader QLabel {
    color: #C9CBD1;
    font-size: 10pt;
}
QWidget#simproHeader QLabel#label_board {
    color: #E0242B;
    border: 1px solid #C8161D;
    border-radius: 3px;
    padding: 2px 10px;
    font-weight: bold;
}
QWidget#simproHeader QLabel#label_memfree {
    color: #FFFFFF;
    font-weight: bold;
}

/* ---------- Secondary tabs (e.g. "Frequently Used / Other Effects") ---------- */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #33363F;
    background: transparent;
    top: -1px;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: transparent;
    color: #C9CBD1;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    margin-right: 4px;
}
QTabBar::tab:hover {
    color: #FFFFFF;
}
QTabBar::tab:selected {
    color: #E0242B;
    border-bottom: 2px solid #C8161D;
}

/* ---------- Cards (group boxes) ---------- */
QGroupBox {
    background-color: #1D1F25;
    border: 1px solid #2C2F37;
    border-radius: 8px;
    margin-top: 0px;
    padding: 42px 10px 10px 10px;
    font-size: 12pt;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 0px;
    top: 0px;
    padding: 12px 16px 0px 16px;
    color: #FFFFFF;
    background: transparent;
}
QGroupBox:disabled::title {
    color: #5E616A;
}
/* Section inside a card ("Basic", "Vehicle") */
QGroupBox QGroupBox {
    background-color: transparent;
    border: none;
    border-top: 1px solid #2C2F37;
    border-radius: 0px;
    padding: 32px 0px 4px 0px;
    font-size: 10.5pt;
}
QGroupBox QGroupBox::title {
    padding: 10px 0px 0px 0px;
    color: #E6E7EA;
}

/* Restore normal weight/size for content inside cards */
QGroupBox QLabel,
QGroupBox QPushButton,
QGroupBox QToolButton,
QGroupBox QCheckBox,
QGroupBox QRadioButton,
QGroupBox QComboBox,
QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox,
QGroupBox QLineEdit,
QGroupBox QTextEdit,
QGroupBox QTextBrowser,
QGroupBox QPlainTextEdit,
QGroupBox QListView,
QGroupBox QListWidget,
QGroupBox QTableView,
QGroupBox QProgressBar {
    font-size: 10pt;
    font-weight: normal;
}

QFrame[frameShape="4"],  /* HLine */
QFrame[frameShape="5"] { /* VLine */
    color: #33363F;
    background-color: #33363F;
    border: none;
    max-height: 1px;
}
QFrame[frameShape="5"] {
    max-height: 16777215px;
    max-width: 1px;
}

QScrollArea, QScrollArea > QWidget > QWidget, QStackedWidget {
    background: transparent;
    border: none;
}

/* ---------- Buttons ---------- */
QPushButton, QToolButton {
    background-color: #2B2E36;
    color: #F2F2F2;
    border: 1px solid #3C3F48;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 18px;
}
QToolButton {
    padding: 4px;
}
QPushButton:hover, QToolButton:hover {
    background-color: #353841;
    border-color: #5A5D66;
}
QPushButton:pressed, QToolButton:pressed {
    background-color: #C8161D;
    border-color: #C8161D;
    color: #FFFFFF;
}
QPushButton:checked, QToolButton:checked {
    background-color: #C8161D;
    border-color: #C8161D;
    color: #FFFFFF;
}
QPushButton:default {
    background-color: #C8161D;
    border-color: #C8161D;
    color: #FFFFFF;
}
QPushButton:default:hover {
    background-color: #E0242B;
}
QPushButton:disabled, QToolButton:disabled {
    background-color: #23252C;
    border-color: #2C2F37;
    color: #5E616A;
}
QPushButton::menu-indicator {
    subcontrol-position: right center;
    right: 6px;
}

/* ---------- Inputs ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateTimeEdit {
    background-color: #17181C;
    color: #F2F2F2;
    border: 1px solid #3C3F48;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 18px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: #5A5D66;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #C8161D;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #1F2127;
    border-color: #2C2F37;
    color: #5E616A;
}

QSpinBox, QDoubleSpinBox {
    padding-right: 20px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background: transparent;
    border: none;
    border-left: 1px solid #2C2F37;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 4px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 4px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #2B2E36;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(@THEME@/arrow_up.svg);
    width: 8px; height: 5px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(@THEME@/arrow_down.svg);
    width: 8px; height: 5px;
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:off {
    image: url(@THEME@/arrow_up_disabled.svg);
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:off {
    image: url(@THEME@/arrow_down_disabled.svg);
}

QComboBox {
    padding-right: 26px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
}
QComboBox::down-arrow {
    image: url(@THEME@/arrow_down.svg);
    width: 10px; height: 6px;
}
QComboBox::down-arrow:disabled {
    image: url(@THEME@/arrow_down_disabled.svg);
}
QComboBox QAbstractItemView {
    background-color: #1D1F25;
    color: #F2F2F2;
    border: 1px solid #33363F;
    outline: 0;
    selection-background-color: #C8161D;
    selection-color: #FFFFFF;
    padding: 4px;
}

/* ---------- Check boxes / radio buttons ---------- */
QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator, QGroupBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #6A6D76;
    border-radius: 3px;
    background-color: transparent;
}
QCheckBox::indicator:hover {
    border-color: #C9CBD1;
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    background-color: #C8161D;
    border-color: #C8161D;
    image: url(@THEME@/check.svg);
}
QCheckBox::indicator:indeterminate {
    background-color: #7A1014;
    border-color: #C8161D;
}
QCheckBox::indicator:disabled {
    border-color: #3C3F48;
    background-color: #23252C;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #6A6D76;
    border-radius: 8px;
    background-color: transparent;
}
QRadioButton::indicator:hover {
    border-color: #C9CBD1;
}
QRadioButton::indicator:checked {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
                                      stop:0 #E0242B, stop:0.45 #E0242B,
                                      stop:0.55 transparent, stop:1 transparent);
    border-color: #C8161D;
}

/* ---------- Sliders (red handle, thin grey track) ---------- */
QSlider {
    background: transparent;
    min-height: 22px;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #4A4D55;
    border-radius: 2px;
    margin: 0px 7px;
}
QSlider::sub-page:horizontal {
    background: #C8161D;
    border-radius: 2px;
    margin-left: 7px;
}
QSlider::add-page:horizontal {
    background: #4A4D55;
    border-radius: 2px;
    margin-right: 7px;
}
QSlider::handle:horizontal {
    background: #C8161D;
    border: 3px solid #3A0A0C;
    width: 10px;
    height: 10px;
    margin: -6px -7px;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #E0242B;
    border-color: #5A1014;
}
QSlider::groove:vertical {
    width: 4px;
    background: #4A4D55;
    border-radius: 2px;
    margin: 7px 0px;
}
QSlider::add-page:vertical {
    background: #C8161D;
    border-radius: 2px;
    margin-bottom: 7px;
}
QSlider::sub-page:vertical {
    background: #4A4D55;
    border-radius: 2px;
    margin-top: 7px;
}
QSlider::handle:vertical {
    background: #C8161D;
    border: 3px solid #3A0A0C;
    width: 10px;
    height: 10px;
    margin: -7px -6px;
    border-radius: 8px;
}
QSlider::handle:vertical:hover {
    background: #E0242B;
}
QSlider::sub-page:horizontal:disabled, QSlider::add-page:vertical:disabled {
    background: #5E616A;
}
QSlider::handle:disabled {
    background: #5E616A;
    border-color: #2B2E36;
}

/* ---------- Progress bars ---------- */
QProgressBar {
    background-color: #17181C;
    border: 1px solid #33363F;
    border-radius: 4px;
    color: #F2F2F2;
    text-align: center;
    min-height: 14px;
}
QProgressBar::chunk {
    background-color: #C8161D;
    border-radius: 3px;
}
QProgressBar:disabled::chunk {
    background-color: #4A4D55;
}

/* ---------- Text / lists / tables ---------- */
QTextEdit, QTextBrowser, QPlainTextEdit, QListView, QListWidget, QTableView, QTreeView {
    background-color: #17181C;
    color: #E6E7EA;
    border: 1px solid #2C2F37;
    border-radius: 6px;
    padding: 4px;
    alternate-background-color: #1B1D22;
    gridline-color: #2C2F37;
}
QListView::item, QListWidget::item, QTreeView::item {
    padding: 4px 6px;
    border-radius: 3px;
}
QListView::item:hover, QListWidget::item:hover, QTreeView::item:hover {
    background-color: #2B2E36;
}
QListView::item:selected, QListWidget::item:selected,
QTableView::item:selected, QTreeView::item:selected {
    background-color: #C8161D;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #1D1F25;
    color: #C9CBD1;
    border: none;
    border-right: 1px solid #2C2F37;
    border-bottom: 1px solid #2C2F37;
    padding: 6px 8px;
    font-weight: bold;
}
QTableCornerButton::section {
    background-color: #1D1F25;
    border: none;
}

/* ---------- Scroll bars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #3C3F48;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #3C3F48;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:hover {
    background: #5A5D66;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ---------- Status bar (bottom, like SimPro top info strip) ---------- */
QStatusBar {
    background-color: #1B1D22;
    border-top: 1px solid #2C2F37;
    color: #C9CBD1;
}
QStatusBar QLabel {
    color: #C9CBD1;
    padding: 0px 4px;
}
QStatusBar::item {
    border: none;
}
QSizeGrip {
    background: transparent;
}

/* Profile manager card at the bottom of the main window */
QGroupBox#groupBox_main {
    margin: 4px 10px 6px 10px;
}

/* ---------- Message boxes / dialogs ---------- */
QMessageBox, QInputDialog, QFileDialog {
    background-color: #262A33;
}
QMessageBox QLabel {
    color: #F2F2F2;
    font-size: 10pt;
    font-weight: normal;
}
QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ---------- SimPro style values (marked in the .ui files) ---------- */
QLabel[simproValue="true"] {
    color: #FFFFFF;
    font-size: 11pt;
    font-weight: bold;
}
QSpinBox[simproValue="true"], QDoubleSpinBox[simproValue="true"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: #FFFFFF;
    font-size: 11pt;
    font-weight: bold;
    min-width: 64px;
    max-width: 110px;
    padding: 2px 18px 2px 4px;
}
QSpinBox[simproValue="true"]:hover, QDoubleSpinBox[simproValue="true"]:hover {
    border-color: #3C3F48;
    background-color: #17181C;
}
QSpinBox[simproValue="true"]:focus, QDoubleSpinBox[simproValue="true"]:focus {
    border-color: #C8161D;
    background-color: #17181C;
}
QSpinBox[simproValue="true"]::up-button, QDoubleSpinBox[simproValue="true"]::up-button,
QSpinBox[simproValue="true"]::down-button, QDoubleSpinBox[simproValue="true"]::down-button {
    border-left: none;
    width: 14px;
}
QDoubleSpinBox[simproBigValue="true"] {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 30pt;
    font-weight: bold;
    padding: 0px;
}
QLabel[simproCaption="true"] {
    color: #8A8D96;
    font-size: 9pt;
}
QLabel[simproSection="true"] {
    color: #E6E7EA;
    font-size: 10.5pt;
    font-weight: bold;
}
QPushButton[simproPrimary="true"] {
    background-color: #C8161D;
    border: 1px solid #C8161D;
    color: #FFFFFF;
    font-weight: bold;
    padding: 6px 26px;
}
QPushButton[simproPrimary="true"]:hover {
    background-color: #E0242B;
    border-color: #E0242B;
}
QPushButton[simproPrimary="true"]:pressed {
    background-color: #A11016;
}
QPushButton[simproPrimary="true"]:disabled {
    background-color: #4A1518;
    border-color: #4A1518;
    color: #9A9DA6;
}

/* Card titles a bit larger, like "Steer Settings" */
QGroupBox {
    font-size: 12.5pt;
}

/* Spin boxes without arrow buttons (read-only displays).
   Qt computes a 1px wide text field for them when the hidden buttons sit on
   the right, so park the (invisible, zero width) buttons on the left. */
QSpinBox[buttonSymbols="2"], QDoubleSpinBox[buttonSymbols="2"] {
    padding-right: 4px;
}
QSpinBox[buttonSymbols="2"]::up-button, QDoubleSpinBox[buttonSymbols="2"]::up-button {
    subcontrol-origin: border;
    subcontrol-position: top left;
    width: 0px;
    border: none;
}
QSpinBox[buttonSymbols="2"]::down-button, QDoubleSpinBox[buttonSymbols="2"]::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom left;
    width: 0px;
    border: none;
}

/* Explanation boxes shown by the "show explanations" switch */
QLabel[simproInfo="true"] {
    color: #B4B7BF;
    font-size: 9pt;
    font-weight: normal;
    background-color: rgba(200, 22, 29, 18);
    border-left: 2px solid #C8161D;
    border-radius: 3px;
    padding: 5px 8px;
}
SimproInfoToggle {
    background: transparent;
}

/* "Trocar imagem" button on the steering wheel picture */
QToolButton#simproWheelImageButton {
    background-color: rgba(23, 24, 28, 200);
    border: 1px solid #3C3F48;
    border-radius: 4px;
    color: #C9CBD1;
    padding: 3px 18px 3px 5px;
}
QToolButton#simproWheelImageButton:hover {
    border-color: #C8161D;
    color: #FFFFFF;
}
QToolButton#simproWheelImageButton::menu-button {
    border: none;
    border-left: 1px solid #3C3F48;
    width: 14px;
}
QToolButton#simproWheelImageButton::menu-arrow {
    image: url(@THEME@/arrow_down.svg);
    width: 8px; height: 5px;
}

/* Motor state badge (copied from the TMC4671 page, read only) */
QWidget#simproHeader QLabel#simproMotorBadge {
    border-radius: 3px;
    padding: 2px 10px;
    font-weight: bold;
    border: 1px solid #5E616A;
    color: #9A9DA6;
}
QWidget#simproHeader QLabel#simproMotorBadge[motorState="ready"] {
    color: #3FD07A;
    border-color: #2EA862;
    background-color: rgba(46, 168, 98, 30);
}
QWidget#simproHeader QLabel#simproMotorBadge[motorState="notready"] {
    color: #E0242B;
    border-color: #C8161D;
    background-color: rgba(200, 22, 29, 30);
}
